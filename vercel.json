{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/2026",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sponsorship",
      "destination": "/sponsor",
      "permanent": true
    },
    {
      "source": "/partners",
      "destination": "/sponsor",
      "permanent": true
    }
  ]
}
